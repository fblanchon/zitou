{# Home page of zitou.fr: a sunny sky (starry in the dark look) holding a living wordmark whose "o" smiles back,
   then the good thought of the day with its polaroid. Styles, script, pictures and fonts live in public/accueil/;
   the picture credits are in public/accueil/images/CREDITS.md. #}
{% extends 'base.html.twig' %}

{% set thoughts = [
    {name: 'crepes', author: 'Marina M', url: 'https://www.pexels.com/photo/pancakes-with-strawberries-and-blueberries-5663303/'},
    {name: 'loutres', author: 'Stephen Leonardi', url: 'https://www.pexels.com/photo/playful-sea-otters-in-tranquil-waters-30549917/'},
    {name: 'lune', author: 'Tommy Picone', url: 'https://www.pexels.com/photo/full-moon-against-black-night-sky-30968622/'},
    {name: 'chocolat', author: 'Polina Tankilevitch', url: 'https://www.pexels.com/photo/close-up-shot-of-chocolates-on-yellow-background-5469121/'},
    {name: 'danse-cuisine', author: 'Vitaly Gariev', url: 'https://www.pexels.com/photo/man-dancing-joyfully-in-modern-kitchen-36812182/'},
    {name: 'chien-mer', author: 'Gabi Orrico', url: 'https://www.pexels.com/photo/dog-playing-in-water-on-seashore-20833736/'},
    {name: 'chat-etirement', author: 'K Zhao', url: 'https://www.pexels.com/photo/ginger-cat-stretching-on-gingham-cloth-outdoors-35229513/'},
    {name: 'chocolat-chaud', author: 'Skyler Ewing', url: 'https://www.pexels.com/photo/falling-marshmallows-on-a-ceramic-mug-10002425/'},
    {name: 'arbres', author: 'Marc Schneider', url: 'https://www.pexels.com/photo/a-photo-of-two-trees-looking-up-at-the-sky-27487326/'},
    {name: 'telephone', author: 'Ann H', url: 'https://www.pexels.com/photo/colorful-toy-telephone-14128138/'},
    {name: 'quokka', author: 'Sergey Guk', url: 'https://www.pexels.com/photo/adorable-quokka-on-rottnest-island-australia-30652256/'},
    {name: 'tartine', author: 'Rebecca Strada', url: 'https://www.pexels.com/photo/artistic-presentation-of-jam-toast-on-blue-background-39353782/'},
    {name: 'flaque', author: 'Dylann Hendricks', url: 'https://www.pexels.com/photo/a-reflection-of-a-walking-child-15171037/'},
    {name: 'amis', author: 'Antoni Shkraba Production', url: 'https://www.pexels.com/photo/portrait-of-friends-posing-for-selfie-8910376/'},
    {name: 'printemps', author: 'Jan van der Wolf', url: 'https://www.pexels.com/photo/white-cherry-blossoms-in-bloom-9476959/'},
    {name: 'pique-nique', author: 'Kampus Production', url: 'https://www.pexels.com/photo/a-family-having-a-picnic-7669127/'},
] %}

{% block stylesheets %}
    {{ parent() }}
    <meta name="description" content="{{ 'site.home.lede'|trans }} {{ 'site.home.lede_emphasis'|trans }}.">
    <link rel="preload" href="{{ asset('accueil/polices/fraunces-latin-full-normal.woff2') }}" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{{ asset('accueil/polices/caveat-latin-600-normal.woff2') }}" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="{{ asset('accueil/accueil.css') }}">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('accueil/accueil.js') }}" defer></script>
{% endblock %}

{% block body %}
    {% set first = thoughts|first %}
    <main class="zitou-home"
        data-greetings="{{ {
            night: 'site.home.greeting.night'|trans,
            morning: 'site.home.greeting.morning'|trans,
            afternoon: 'site.home.greeting.afternoon'|trans,
            evening: 'site.home.greeting.evening'|trans,
            late: 'site.home.greeting.late'|trans,
        }|json_encode }}"
        data-date-prefix="{{ 'site.home.joy.date_prefix'|trans }}"
        data-thoughts="{{ thoughts|map(thought => {
            text: ('site.home.thoughts.' ~ thought.name ~ '.text')|trans,
            caption: ('site.home.thoughts.' ~ thought.name ~ '.caption')|trans,
            alt: ('site.home.thoughts.' ~ thought.name ~ '.alt')|trans,
            image: asset('accueil/images/' ~ thought.name ~ '.webp'),
        })|json_encode }}">
        <section class="sky" aria-labelledby="zitou-home-title">
            <div class="stars" aria-hidden="true"></div>
            <div class="orb" aria-hidden="true">
                <div class="orb-rays"></div>
                <div class="orb-disc"><span class="crater"></span><span class="crater"></span><span class="crater"></span><span class="crater"></span></div>
            </div>

            <div class="floaties" aria-hidden="true">
                <div class="floaty optional" style="--x:6%;--y:74%;--w:2.4rem;--d:-18;--t:6s">
                    <svg viewBox="0 0 40 40"><path d="M20 2l5 12 13 1-10 8 3 13-11-7-11 7 3-13L2 15l13-1z" fill="var(--sun)" stroke="var(--sticker)" stroke-width="2.5" stroke-linejoin="round"/></svg>
                </div>
                <div class="floaty optional" style="--x:46%;--y:12%;--w:2rem;--d:14;--t:8s;--delay:-2s">
                    <svg viewBox="0 0 40 40"><circle cx="20" cy="20" r="14" fill="none" stroke="var(--bubble)" stroke-width="7"/></svg>
                </div>
                <div class="floaty" style="--x:86%;--y:58%;--w:3.6rem;--d:22;--t:9s;--delay:-4s">
                    <svg viewBox="0 0 60 24"><path d="M4 14c6-10 10-10 14 0s8 10 13 0 8-10 13 0 8 6 12 2" fill="none" stroke="var(--mint)" stroke-width="6" stroke-linecap="round"/></svg>
                </div>
                <div class="floaty" style="--x:72%;--y:80%;--w:2.2rem;--d:-12;--t:7s;--delay:-1s">
                    <svg viewBox="0 0 40 40"><path d="M20 35S4 25 4 14a8 8 0 0 1 16-2 8 8 0 0 1 16 2c0 11-16 21-16 21z" fill="var(--bubble)" stroke="var(--sticker)" stroke-width="2.5" stroke-linejoin="round"/></svg>
                </div>
                <div class="floaty optional" style="--x:62%;--y:42%;--w:1.5rem;--d:26;--t:6.5s;--delay:-3s">
                    <svg viewBox="0 0 30 30"><path d="M15 3v24M3 15h24" stroke="var(--blue)" stroke-width="6" stroke-linecap="round"/></svg>
                </div>
                <div class="floaty optional" style="--x:93%;--y:30%;--w:2.6rem;--d:-20;--t:10s;--delay:-6s">
                    <svg viewBox="0 0 40 40"><path d="M8 30c-4-9 1-22 13-24 10-2 17 7 13 16-3 8-9 13-16 13-4 0-8-1-10-5z" fill="var(--tangerine)" stroke="var(--sticker)" stroke-width="2.5"/></svg>
                </div>
            </div>

            <div class="wrap">
                <p class="greeting" data-zitou-home="greeting">{{ 'site.home.greeting.default'|trans }}</p>

                <h1 class="wordmark" id="zitou-home-title">
                    <span class="visually-hidden">{{ 'site.name'|trans }}</span>
                    <span class="letters" aria-hidden="true">
                        <span class="letter" style="--i:0;--c:var(--tangerine)">z</span><span class="letter" style="--i:1;--c:var(--bubble)">i</span><span class="letter" style="--i:2;--c:var(--sun)">t</span><span class="letter face" data-zitou-home="face" style="--i:3">
                            <span class="psst" data-zitou-home="psst"><svg viewBox="0 0 40 40"><path d="M34 6C24 6 12 12 9 30m0 0l-4-7m4 7l7-4" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg><span><span class="mouse-only">{{ 'site.home.psst_mouse'|trans }}</span><span class="touch-only">{{ 'site.home.psst_touch'|trans }}</span></span></span>
                            <span class="eye left"><span class="pupil"></span></span>
                            <span class="eye right"><span class="pupil"></span></span>
                            <span class="cheek left"></span><span class="cheek right"></span>
                            <svg class="mouth" viewBox="0 0 40 22"><path class="smile" d="M5 5 Q20 19 35 5" fill="none" stroke="var(--pupil)" stroke-width="4.5" stroke-linecap="round"/><path class="grin" d="M3 3 Q20 3 37 3 Q34 22 20 22 Q6 22 3 3 Z" fill="var(--pupil)"/></svg>
                        </span><span class="letter" style="--i:4;--c:var(--blue)">u</span>
                    </span>
                </h1>

                <p class="lede">{{ 'site.home.lede'|trans }} <em>{{ 'site.home.lede_emphasis'|trans }}</em>.</p>
                <p class="intro">{{ 'site.home.intro'|trans }}</p>

                <div class="actions">
                    <button class="button" type="button" data-zitou-home="party">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 21l5-14 9 9-14 5z" fill="var(--bubble)" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M14 3c0 2 1 3 3 3M20 9c-2 0-3 1-3 3M18 2.5v.01M21.5 5v.01M11 5.5v.01" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                        {{ 'site.home.confetti'|trans }}
                    </button>
                    <a class="link-down" href="#bonheur">{{ 'site.home.see_joy'|trans }}</a>
                </div>
            </div>

            <svg class="horizon" viewBox="0 0 1440 130" preserveAspectRatio="none" aria-hidden="true">
                <path class="back" d="M0 70 C 180 20, 360 20, 540 60 S 900 110, 1080 60 S 1340 20, 1440 50 L1440 130 L0 130 Z"/>
                <path class="front" d="M0 100 C 220 60, 420 70, 640 95 S 1060 130, 1260 90 S 1400 70, 1440 80 L1440 130 L0 130 Z"/>
            </svg>
        </section>

        <section class="daily" id="bonheur" aria-labelledby="zitou-home-joy-label">
            <div class="wrap">
                <div class="joy-stack">
                    <figure class="polaroid" data-zitou-home="polaroid">
                        <span class="tape" aria-hidden="true"></span>
                        <img data-zitou-home="joy-image" src="{{ asset('accueil/images/' ~ first.name ~ '.webp') }}" width="640" height="640" alt="{{ ('site.home.thoughts.' ~ first.name ~ '.alt')|trans }}">
                        <figcaption data-zitou-home="joy-caption">{{ ('site.home.thoughts.' ~ first.name ~ '.caption')|trans }}</figcaption>
                    </figure>
                    <div class="joy">
                        <svg class="joy-sticker" viewBox="0 0 80 80" aria-hidden="true">
                            <path d="M40 4l7 14 15-5-3 16 16 5-12 11 9 13-16 2 1 16-14-8-10 12-6-15-16 3 6-15L3 42l15-7-5-15 16 3z" fill="var(--bubble)" stroke="var(--sticker)" stroke-width="2.5" stroke-linejoin="round"/>
                            <circle cx="33" cy="36" r="3.4" fill="var(--pupil)"/><circle cx="47" cy="36" r="3.4" fill="var(--pupil)"/>
                            <path d="M31 46q9 9 18 0" fill="none" stroke="var(--pupil)" stroke-width="3.4" stroke-linecap="round"/>
                        </svg>
                        <h2 class="joy-label" id="zitou-home-joy-label">{{ 'site.home.joy.label'|trans }}</h2>
                        <p class="joy-date" data-zitou-home="joy-date">{{ 'site.home.joy.today'|trans }}</p>
                        <p class="joy-quote" data-zitou-home="joy-quote" aria-live="polite">{{ ('site.home.thoughts.' ~ first.name ~ '.text')|trans }}</p>
                        <button class="button" type="button" data-zitou-home="joy-next">{{ 'site.home.joy.next'|trans }}</button>
                    </div>
                </div>
            </div>
        </section>

        <div class="wrap end">
            <p class="goodbye">{{ 'site.home.goodbye'|trans }}</p>
            <details class="thanks">
                <summary>{{ 'site.home.thanks'|trans }}</summary>
                <ul>
                    {% for thought in thoughts %}
                        <li>{{ ('site.home.thoughts.' ~ thought.name ~ '.subject')|trans }} : <a href="{{ thought.url }}" rel="noopener" target="_blank">{{ thought.author }}</a></li>
                    {% endfor %}
                </ul>
            </details>
        </div>

        <canvas class="zitou-home-confetti" data-zitou-home="confetti" aria-hidden="true"></canvas>
    </main>
{% endblock %}
