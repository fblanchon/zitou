# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Local PostgreSQL 16 with a role "app" (password "app") allowed to create databases:
#   sudo -u postgres psql -c "CREATE ROLE app LOGIN CREATEDB PASSWORD 'app'"
# Name the database after the site. Override in .env.local if your setup differs.
# Tests use the same server with a "_test" suffix.
DATABASE_URL="postgresql://app:app@127.0.0.1:5432/zitou?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
# Development: Mailpit (make mailpit-up in zitou-core) catches every e-mail on http://127.0.0.1:8025.
MAILER_DSN=smtp://127.0.0.1:1025
MAILER_FROM=no-reply@zitou.localhost
# Receives the team's notices while the "Administration e-mail" setting is empty. Empty: nothing is sent.
ZITOU_ADMIN_EMAIL=
###< symfony/mailer ###

###> symfony/messenger ###
# Queue of the background worker: a table of the database, created by the migrations of the engine.
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0&table_name=zitou_messenger_message
###< symfony/messenger ###

###> zitou/captcha ###
# Anti-robot check of the forms: turnstile (default) or recaptcha. Without both keys, only the trap
# field protects the forms. The real keys go in .env.local.
ZITOU_CAPTCHA_PROVIDER=
ZITOU_CAPTCHA_SITE_KEY=
ZITOU_CAPTCHA_SECRET_KEY=
###< zitou/captcha ###
