{
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@zitou/*": [
                "vendor/fblanchon/zitou-core/assets/*"
            ],
            "@zitou-modules/*": [
                "vendor/fblanchon/zitou-core/src/Module/*"
            ],
            "@zitou-client/*": [
                "./*"
            ],
            "@zitou-translations/*": [
                "var/zitou/translations/*"
            ]
        }
    },
    "include": [
        "assets/**/*",
        "src/**/*",
        "vendor/fblanchon/zitou-core/assets/**/*",
        "vendor/fblanchon/zitou-core/src/Module/**/*"
    ],
    "exclude": [
        "node_modules",
        "vendor/fblanchon/zitou-core/node_modules",
        "var",
        "public"
    ]
}
